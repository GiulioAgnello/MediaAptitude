# Base URL della REST custom del WordPress headless.
# Dev (LocalWP): http://mediaaptitude.local/wp-json/mediaaptitude/v1
# Prod (Cloudflare Pages): il frontend sta su www (Cloudflare), mentre WordPress
#   resta su Aruba ed è raggiunto via il sottodominio cms, proxato da Cloudflare
#   con Host-override → www (così Aruba serve WP senza il redirect forzato a www).
#   Questo valore va impostato come variabile d'ambiente nel progetto Cloudflare Pages.
# Prod: https://cms.media-aptitude.it/wp-json/mediaaptitude/v1
WP_API_URL=http://mediaaptitude.local/wp-json/mediaaptitude/v1

# Google Places API — recensioni Google importate a BUILD-TIME (opzionale).
# Serve un progetto Google Cloud con Places API attiva e fatturazione abilitata.
# Il Place ID (pubblico) va in src/data/site.ts (google.placeId); la key resta qui.
# Se vuota, le recensioni non vengono caricate e la sezione resta nascosta.
GOOGLE_PLACES_API_KEY=

# VALVOLA DI EMERGENZA — lasciare VUOTA in condizioni normali.
# Con WP_API_URL remoto (produzione) la build FALLISCE di proposito se un
# endpoint critico di WordPress non risponde: meglio nessun deploy che un sito
# pubblicato con contenuti finti, link a pagine mai generate (404) e sitemap
# sbagliata. Impostare a 1 SOLO se serve pubblicare col CMS giù, accettando che
# i contenuti siano quelli statici di src/data/content.ts.
ALLOW_MOCK_FALLBACK=
