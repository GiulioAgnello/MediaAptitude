---
/**
 * Hero home: badge, h1 con entrata blur-in, lead, CTA e foto grande
 * incorniciata con glow gradiente (stile riferimento).
 *
 * CONTENUTI EDITABILI DA WORDPRESS: Impostazioni → Media Aptitude → "Hero home".
 * Ogni campo lasciato vuoto in WP ricade sui default qui sotto, così il sito
 * resta coerente anche se il CMS è offline o la sezione non è compilata.
 * Nota: essendo un sito statico, le modifiche vanno online alla ripubblicazione.
 */
import { Picture } from 'astro:assets';
import Button from './Button.astro';
import { cta } from '../data/site';
import { getHero } from '../lib/settings';
import heroImg from '../assets/home-team.jpg';

const hero = await getHero();

/** Default statici: fonte di verità quando WP non fornisce il valore. */
const badge = hero.badge ?? 'Agenzia digitale a Lecce e nel Salento';
const title = hero.title ?? 'Il digitale che porta clienti alle imprese del Salento';
const lead =
  hero.lead ??
  'Siti web, e-commerce, SEO e software su misura per aziende e professionisti di Lecce e provincia. Progetti veloci, curati e costruiti per farti trovare.';
const ctaLabel = hero.ctaLabel ?? cta.label;
const ctaHref = hero.ctaHref ?? cta.href;
const cta2Label = hero.cta2Label ?? 'Scopri i servizi';
const cta2Href = hero.cta2Href ?? '/#servizi';
const imageAlt = hero.imageAlt ?? 'Il team di Media Aptitude al lavoro nello studio di Lecce';

// Foto: quella caricata in WP se presente, altrimenti l'asset locale.
// In entrambi i casi passa da astro:assets → AVIF/WebP responsive a build-time.
const remoteImage = hero.image;
// Non chiedo varianti più larghe dell'originale: sarebbe upscaling inutile.
const sourceWidth = remoteImage?.width ?? heroImg.width;
const candidates = [640, 960, 1280, 1600].filter((w) => w <= sourceWidth);
const widths = candidates.length > 0 ? candidates : [sourceWidth];
const sizes = '(max-width: 1140px) 100vw, 1080px';
---

<section class="hero">
  <div class="container hero__inner">
    <p class="hero__badge" data-enter>{badge}</p>

    <h1 data-enter="2">{title}</h1>

    <p class="hero__lead" data-enter="3">{lead}</p>

    <div class="hero__actions" data-enter="4">
      <Button href={ctaHref} variant="primary">{ctaLabel}</Button>
      {cta2Label && <Button href={cta2Href} variant="secondary">{cta2Label}</Button>}
    </div>

    <figure class="hero__media" data-enter="4">
      {/* astro:assets: genera AVIF/WebP responsive + width/height (no CLS).
          È l'immagine LCP → eager + fetchpriority alta. */}
      {
        remoteImage ? (
          <Picture
            src={remoteImage.url}
            width={remoteImage.width}
            height={remoteImage.height}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        ) : (
          <Picture
            src={heroImg}
            formats={['avif', 'webp']}
            widths={widths}
            sizes={sizes}
            alt={imageAlt}
            loading="eager"
            fetchpriority="high"
          />
        )
      }
    </figure>
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding-top: clamp(8rem, 6rem + 8vw, 12rem);
    text-align: center;
    /* alone soffuso dietro al titolo, come il cielo del riferimento */
    background:
      radial-gradient(50% 38% at 50% 18%, rgba(77, 141, 255, 0.14) 0%, transparent 70%),
      radial-gradient(30% 24% at 38% 10%, rgba(255, 172, 10, 0.07) 0%, transparent 70%);
  }
  .hero__inner {
    display: grid;
    justify-items: center;
    gap: var(--sp-5);
  }

  .hero__badge {
    padding: 0.4rem 1rem;
    font-size: var(--fs-xs);
    color: var(--c-text-secondary);
    background: var(--c-surface);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-full);
    backdrop-filter: blur(8px);
  }

  h1 { max-width: 17ch; }

  .hero__lead {
    max-width: 52ch;
    font-size: var(--fs-md);
  }

  .hero__actions {
    display: flex;
    gap: var(--sp-3);
    flex-wrap: wrap;
    justify-content: center;
  }

  /* Cornice foto: bordo translucido, radius grande, glow ambra/blu ai lati */
  .hero__media {
    margin-top: var(--sp-7);
    width: min(100%, 1080px);
    border: 1px solid var(--c-line);
    border-radius: var(--radius-lg);
    overflow: hidden;
    box-shadow:
      var(--shadow-lg),
      -40px -10px 120px -60px rgba(255, 172, 10, 0.5),
      40px -10px 120px -60px rgba(77, 141, 255, 0.55);
  }
  .hero__media img { width: 100%; }
</style>
